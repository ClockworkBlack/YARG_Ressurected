+        /// <summary>
+        /// Sound without a tone (breath, a consonant, noise) only means something on a spoken
+        /// note, and in Vocals Challenge Mode not even there. Anywhere else it is as if nothing
+        /// was heard, so that it does not come between the sung readings before and after it.
+        /// </summary>
+        private bool IsSoundThatCannotCount(VocalNote? note)
+        {
+            return SangUnpitched && (note is null || !note.IsNonPitched || EngineParameters.VoicedOnly);
+        }
+
+        // ---- Vocals Challenge Mode: note-by-note scoring ----
+        //
+        // The normal scoring above only adds up how much of a phrase was sung. Here every note
+        // keeps its own tally as well, so a phrase can be refused when notes were skipped, and
+        // the credit is exact: it never reaches outside the note, the start of a note is
+        // forgiven while the singer finds it (EdgeGrace), and an input just after a note
+        // still counts for the end of that note.
+
+        private void ClearNoteTracking()
+        {
+            _trackedNotes.Clear();
+            _trackedStart.Clear();
+            _trackedEnd.Clear();
+            _trackedStartTime.Clear();
+            _trackedEndTime.Clear();
+            _trackedHit.Clear();
+            _trackedCreditedTo.Clear();
+            _trackedLastPercent.Clear();
+            _trackedJudged = 0;
+            _lastTrackedIndex = -1;

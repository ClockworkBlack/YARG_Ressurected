+
+        private void BeginNoteTracking(VocalNote phrase)
+        {
+            ClearNoteTracking();
+            PhraseNotesMissed = 0;
+
+            if (CarriedVocalNote != null)
+            {
+                TrackNote(phrase, CarriedVocalNote);
+            }
+
+            var childNotes = phrase.ChildNotes;
+            for (int i = 0; i < childNotes.Count; i++)
+            {
+                if (!childNotes[i].IsPercussion)
+                {
+                    TrackNote(phrase, childNotes[i]);
+                }
+            }
+        }
+
+        private void TrackNote(VocalNote phrase, VocalNote note)
+        {
+            // The same bounds as GetTicksForNote: only the part of the note inside the phrase
+            uint start = Math.Max(note.Tick, phrase.Tick);
+            uint end = Math.Min(note.TotalTickEnd, phrase.TickEnd);
+            if (start >= end)
+            {
+                return;
+            }
+
+            _trackedNotes.Add(note);
+            _trackedStart.Add(start);
+            _trackedEnd.Add(end);
+            _trackedStartTime.Add(SyncTrack.TickToTime(start));
+            _trackedEndTime.Add(SyncTrack.TickToTime(end));
+            _trackedHit.Add(0);
+            _trackedCreditedTo.Add(start);
+            _trackedLastPercent.Add(0f);
+        }
+
+        private void CheckSingingHitTracked(VocalNote phrase, uint lastSingTick)
+        {
+            // The stretch of the song this input can answer for: back to the previous input,
+            // but never further than one input period.
+            double maxLeniency = 1.0 / EngineParameters.ApproximateVocalFps;
+            uint reachBack = Math.Max(SyncTrack.TimeToTick(CurrentTime - maxLeniency), lastSingTick);
+
+            var note = GetNoteInPhraseAtSongTick(phrase, CurrentTick);
+
+            if (IsSoundThatCannotCount(note))
+            {
+                LastSingTick = lastSingTick;
+                OnHit?.Invoke(false);
+                return;
+            }
+
+            int index = -1;
+            if (note != null)
+            {
+                // By identity: notes compare equal by value, and two notes can be alike
+                for (int i = 0; i < _trackedNotes.Count; i++)
+                {
+                    if (ReferenceEquals(_trackedNotes[i], note))
+                    {
+                        index = i;
+                        break;
+                    }
+                }
+            }
+
+            // The end of the note before this one, if this input reaches back into it
+            if (_lastTrackedIndex >= 0 && _lastTrackedIndex != index)
+            {
+                CreditTrackedNote(_lastTrackedIndex, reachBack, true);
+            }
+
+            if (note is null)
+            {
+                // If we're not on a note, we cannot be hitting a note
+                OnHit?.Invoke(false);
+                return;
+            }
+
+            OnTargetNoteChanged?.Invoke(note);
+
+            // (Work the result out first: "OnHit?.Invoke(...)" skips its arguments when
+            // nothing is listening.)
+            bool hitting;
+            if (index < 0)
+            {
+                // Not a note of this phrase's tally (it lies outside the phrase's bounds)
+                hitting = CanVocalNoteBeHit(note, out _);
+            }
+            else
+            {
+                _lastTrackedIndex = index;
+                hitting = CreditTrackedNote(index, reachBack, false);
+            }
+
+            OnHit?.Invoke(hitting);
+        }
+
+        /// <returns>Whether the current input hits the note.</returns>
+        private bool CreditTrackedNote(int index, uint reachBack, bool isTail)
+        {
+            uint start = _trackedStart[index];
+            uint end = _trackedEnd[index];
+
+            if (isTail && (CurrentTick <= end || reachBack >= end))
+            {
+                return false;
+            }
+
+            if (!CanVocalNoteBeHit(_trackedNotes[index], out float hitPercent))
+            {
+                return false;
+            }
+
+            // The first hit on a note, soon enough after its start, is credited from its start
+            if (!isTail && _trackedHit[index] <= 0 &&
+                CurrentTime - _trackedStartTime[index] <= EngineParameters.EdgeGrace)
+            {
+                reachBack = start;
+            }
+
+            uint creditFrom = Math.Max(reachBack, _trackedCreditedTo[index]);
+            uint creditTo = Math.Min(CurrentTick, end);
+            if (creditTo > creditFrom)
+            {
+                double credit = (creditTo - creditFrom) * hitPercent;
+                PhraseTicksHit += credit;
+                _trackedHit[index] += credit;
+                _trackedCreditedTo[index] = creditTo;
+                _trackedLastPercent[index] = hitPercent;
+            }
+
+            return true;
+        }
+
+        /// <summary>
+        /// Counts the notes that are over and were not sung enough. During the phrase a note is
+        /// judged once no input can add to it any more; at the end of the phrase all are.
+        /// </summary>
+        private void JudgeTrackedNotes(bool phraseOver)
+        {
+            double maxLeniency = 1.0 / EngineParameters.ApproximateVocalFps;
+            while (_trackedJudged < _trackedNotes.Count)
+            {
+                int index = _trackedJudged;
+                if (!phraseOver && CurrentTime - maxLeniency <= _trackedEndTime[index])
+                {
+                    break;
+                }
+
+                // A note held until just before its end is credited to its end: singers leave
+                // a note a moment early to breathe or to reach the next one
+                uint creditedTo = _trackedCreditedTo[index];
+                if (_trackedHit[index] > 0 && creditedTo < _trackedEnd[index] &&
+                    _trackedEndTime[index] - SyncTrack.TickToTime(creditedTo) <= EngineParameters.EdgeGrace)
+                {
+                    double credit = (_trackedEnd[index] - creditedTo) * _trackedLastPercent[index];
+                    PhraseTicksHit += credit;
+                    _trackedHit[index] += credit;
+                    _trackedCreditedTo[index] = _trackedEnd[index];
+                }
+
+                bool longEnough = _trackedEndTime[index] - _trackedStartTime[index] >= MIN_JUDGED_NOTE_SECONDS;
+                uint ticks = _trackedEnd[index] - _trackedStart[index];
+                double sungPercent = _trackedHit[index] / ticks;
+                bool counted = EngineParameters.NoteHitPercent <= 0 || !longEnough ||
+                    sungPercent >= EngineParameters.NoteHitPercent;
+                if (!counted)
+                {
+                    PhraseNotesMissed++;
+                }
+
+                _trackedJudged++;
+                OnNoteJudged?.Invoke(_trackedNotes[index], sungPercent, counted);
+            }
+        }

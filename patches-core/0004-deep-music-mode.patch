+            if ((modifiers & Modifier.DeepMusicMode) != 0)
+            {
+                var deep = instrument switch
+                {
+                    Instrument.FiveFretGuitar => FiveFretCoop,
+                    Instrument.FiveFretBass => FiveFretRhythm,
+                    _ => null
+                };
+                if (deep != null && deep.TryGetDifficulty(difficulty, out var notes) && notes.Notes.Count > 0)
+                {
+                    return deep;
+                }
+            }
+
+            return GetFiveFretTrack(instrument);
+        }

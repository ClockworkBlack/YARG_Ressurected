+        private void ToggleFavorite()
+        {
+            var selection = CurrentSelection;
+            if (selection == null || !selection.GetFavoriteInfo().ShowFavoriteButton)
+            {
+                return;
+            }
+
+            bool wasFavorite = selection.GetFavoriteInfo().IsFavorited;
+            string name = selection is SongViewType songView ? songView.SongEntry.Name.ToString() : "Song";
+            selection.FavoriteClick();
+
+            if (wasFavorite)
+            {
+                ToastManager.ToastInformation($"{name}: removed from Favorites");
+                return;
+            }
+
+            // The first favorites become the menu music, unless a playlist was already chosen for it
+            var source = SettingsManager.Settings.MenuMusicSource;
+            if (string.IsNullOrEmpty(source.Value) || source.Value == MenuMusic.SOURCE_ALL)
+            {
+                source.SetValueWithoutNotify(MenuMusic.SOURCE_FAVORITES);
+                SettingsManager.SaveSettings();
+                ToastManager.ToastSuccess($"{name}: added to Favorites.\nThe menus now play your Favorites.");
+            }
+            else
+            {
+                ToastManager.ToastSuccess($"{name}: added to Favorites");
+            }
+
+            RefreshViewsObjects();
+        }

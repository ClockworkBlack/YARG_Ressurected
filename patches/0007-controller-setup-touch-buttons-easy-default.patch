-        private static bool IsDeviceInActiveProfile(InputDevice device) =>
-            PlayerContainer.Players
-                .Where(p => p.InputsEnabled)
-                .Any(p => p.Bindings.InputDevices.Contains(device));
+        // Whether a profile handles this device's menu buttons itself, so the built-in gamepad menu
+        // buttons should stay quiet for it. A gamepad that is in a profile but has no menu buttons there
+        // (just added and not set up yet, or its set-up was cancelled) keeps the built-in ones, so the
+        // controller can always move around the menus.
+        private static bool IsDeviceInActiveProfile(InputDevice device)
+        {
+            foreach (var player in PlayerContainer.Players)
+            {
+                if (player.Bindings == null || !player.Bindings.ContainsDevice(device))
+                {
+                    continue;
+                }
+
+                // Inputs are switched off while its buttons are being re-bound: don't navigate then
+                if (!player.InputsEnabled)
+                {
+                    return true;
+                }
+
+                // A PlayStation / Xbox pad left in a profile with no buttons at all (older builds could
+                // do that when the "which kind of controller" question was closed): set it up now
+                if (device is Gamepad gamepad && !player.Bindings.ContainsBindingsForDevice(gamepad) &&
+                    ControllerLayout.IsStandardGamepad(gamepad) && DialogManager.Instance is { IsDialogShowing: false })
+                {
+                    player.Bindings.SetDefaultBinds(gamepad, GamepadBindingMode.Gamepad);
+                    ToastManager.ToastInformation($"{gamepad.displayName} set up as a gamepad for {player.Profile.Name}");
+                    return false;
+                }
+
+                return player.Bindings.MenuBindings.ContainsBindingsForDevice(device);
+            }
+
+            return false;
+        }
 
         public static void Initialize()
         {

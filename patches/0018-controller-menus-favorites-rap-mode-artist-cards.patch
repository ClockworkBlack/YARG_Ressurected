+        private static bool IsBarTurns(YARG.Gameplay.VocalBattle.SingOffTurns turns) =>
+            turns is YARG.Gameplay.VocalBattle.SingOffTurns.FourBars or YARG.Gameplay.VocalBattle.SingOffTurns.EightBars
+                or YARG.Gameplay.VocalBattle.SingOffTurns.SixteenBars;
+
+        private static int Bars(YARG.Gameplay.VocalBattle.SingOffTurns turns) => turns switch

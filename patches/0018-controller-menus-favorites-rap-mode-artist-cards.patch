+        /// <summary>
+        /// A list of every artist (or genre, album, year, charter) in the library to pick from with a
+        /// controller; picking one shows just its songs. No typing needed.
+        /// </summary>
+        public void Browse(SortAttribute attribute)
+        {
+            StopPreview();
+
+            var groups = new List<(string name, int count)>();
+            void Add<TKey>(IReadOnlyDictionary<TKey, List<SongEntry>> source, Func<TKey, string> name)
+            {
+                if (source == null) return;
+                foreach (var pair in source)
+                {
+                    string label = name(pair.Key);
+                    if (!string.IsNullOrWhiteSpace(label)) groups.Add((label, pair.Value.Count));
+                }
+            }
+
+            string what;
+            switch (attribute)
+            {
+                case SortAttribute.Artist:
+                    Add(SongContainer.Artists, k => k.Original);
+                    what = "Artist";
+                    break;
+                case SortAttribute.Genre:
+                    Add(SongContainer.Genres, k => k.Original);
+                    what = "Genre";
+                    break;
+                case SortAttribute.Album:
+                    Add(SongContainer.Albums, k => k.Original);
+                    what = "Album";
+                    break;
+                case SortAttribute.Charter:
+                    Add(SongContainer.Charters, k => k.Original);
+                    what = "Charter";
+                    break;
+                case SortAttribute.Year:
+                    Add(SongContainer.Years, k => k);
+                    what = "Year";
+                    break;
+                default:
+                    return;
+            }
+
+            groups.Sort((a, b) => string.Compare(a.name, b.name, StringComparison.CurrentCultureIgnoreCase));
+
+            var dialog = DialogManager.Instance.ShowList("Browse by " + what + "\n<size=60%><line-height=60%>\n" +
+                groups.Count + " to choose from. Pick one to see its songs.</size>");
+            dialog.AddListButton("All songs (clear the search)", () => SetSearchInput(attribute, string.Empty));
+            foreach (var (name, count) in groups)
+            {
+                string chosen = name;
+                dialog.AddListButton(name + "   <alpha=#88>(" + count + (count == 1 ? " song)" : " songs)"),
+                    () => SetSearchInput(attribute, "\"" + chosen + "\""));
+            }
+        }

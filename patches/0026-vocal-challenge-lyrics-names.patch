+        // ---------------------------------------------------------------- how fast the words go by
+        // At the standard speed a word crosses a third of the screen every second, whatever the
+        // song: a blur on a phone. Words only have to move as fast as it takes to fit them in one
+        // after another, so each song gets the slowest speed at which its words still arrive on
+        // time (Settings > Graphics > Lyric Scroll Speed: Automatic), never faster than standard.
+
+        /// <summary>The slowest the words may go, against the standard speed.</summary>
+        public const float SLOWEST_SCROLL = 0.55f;
+
+        /// <summary>How late a word may arrive at the sing line, at most, for a speed to be slow enough (seconds).</summary>
+        private const double LATEST_WORD = 0.25;
+
+        /// <summary>The speed the last song's lyrics scrolled at (1 = standard). For the play test and the log.</summary>
+        public static float LastScrollSpeed { get; private set; } = 1f;
+
+        /// <summary>
+        /// True when this song's lines stand still and light up word by word, instead of scrolling:
+        /// chosen in the settings, or (Automatic) because the words are too close together to go
+        /// by slowly. Set when a song's vocals are set up.
+        /// </summary>
+        public static bool StillLyrics { get; private set; }
+
+        /// <summary>Above this speed scrolling words are a blur, so Automatic shows still lines instead.</summary>
+        private const float FASTEST_READABLE_SCROLL = 0.8f;
+
+        private float ChooseScrollSpeed(List<VocalsPart> parts)
+        {
+            var style = SettingsManager.Settings.StaticVocalsMode.Value
+                ? LyricStyle.Still
+                : SettingsManager.Settings.LyricStyle.Value;
+
+            float speed = style == LyricStyle.Still ? 1f : SlowestOnTime(parts);
+            StillLyrics = style == LyricStyle.Still ||
+                (style == LyricStyle.Automatic && speed > FASTEST_READABLE_SCROLL + 0.001f);
+            if (StillLyrics)
+            {
+                // (The notes still scroll; at the standard speed, as before)
+                speed = 1f;
+            }
+
+            LastScrollSpeed = speed;
+            YARG.Core.Logging.YargLogger.LogFormatInfo("Lyrics when singing: {0}, notes scroll at {1}% of the standard speed",
+                StillLyrics ? "still lines" : "scrolling", (int) Math.Round(speed * 100));
+            return speed;
+        }
+
+        /// <summary>The slowest speed, in steps of 5%, at which no word reaches the sing line late.</summary>
+        private float SlowestOnTime(List<VocalsPart> parts)
+        {
+            // Every word's time and width, once
+            var words = new List<(double Time, float Width, int Part)>();
+            try
+            {
+                for (int p = 0; p < parts.Count; p++)
+                {
+                    foreach (var phrase in parts[p].NotePhrases)
+                    {
+                        foreach (var lyric in phrase.Lyrics)
+                        {
+                            if (!lyric.PitchSlide)
+                            {
+                                words.Add((lyric.Time, _lyricContainer.MeasureScrollingWidth(lyric.Text), p));
+                            }
+                        }
+                    }
+                }
+            }
+            catch (Exception e)
+            {
+                YARG.Core.Logging.YargLogger.LogException(e, "Could not measure the lyrics");
+                return 1f;
+            }
+
+            for (float speed = SLOWEST_SCROLL; speed < 0.999f; speed += 0.05f)
+            {
+                if (LatestWord(words, parts.Count, speed * STANDARD_SCROLL_SPEED) <= LATEST_WORD)
+                {
+                    return speed;
+                }
+            }
+
+            return 1f;
+        }
+
+        /// <summary>
+        /// How late the latest word gets at a speed (units a second). Words follow each other with
+        /// a gap, as they are laid out in VocalLyricContainer: a word that has no room yet waits.
+        /// </summary>
+        public static double LatestWord(List<(double Time, float Width, int Part)> words, int parts, float unitsPerSecond)
+        {
+            var edge = new double[Math.Max(1, parts)];
+            for (int i = 0; i < edge.Length; i++)
+            {
+                edge[i] = double.NegativeInfinity;
+            }
+
+            double latest = 0;
+            foreach (var (time, width, part) in words)
+            {
+                double shown = Math.Max(time, edge[part]);
+                latest = Math.Max(latest, shown - time);
+                edge[part] = shown + (width + VocalLyricContainer.LYRIC_SPACING) / unitsPerSecond;
+            }
+
+            return latest;
+        }

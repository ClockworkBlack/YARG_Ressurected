diff --git a/Assets/Script/Gameplay/Player/FiveFretGuitarPlayer.cs b/Assets/Script/Gameplay/Player/FiveFretGuitarPlayer.cs
index 9260e2d..6d1dfa8 100644
--- a/Assets/Script/Gameplay/Player/FiveFretGuitarPlayer.cs
+++ b/Assets/Script/Gameplay/Player/FiveFretGuitarPlayer.cs
@@ -679,12 +679,53 @@ namespace YARG.Gameplay.Player
 
         protected override bool InterceptInput(ref GameInput input)
         {
+            var action = input.GetAction<GuitarAction>();
+
             // Ignore SP in practice mode
-            if (input.GetAction<GuitarAction>() == GuitarAction.StarPower && GameManager.IsPractice) return true;
+            if (action == GuitarAction.StarPower && GameManager.IsPractice) return true;
+
+            // A strum bar's spring-back is not a strum (Settings > General > Strum Bar Bounce Filter)
+            if (action is GuitarAction.StrumUp or GuitarAction.StrumDown && IsStrumBounce(action, input.Button, input.Time))
+            {
+                return true;
+            }
 
             return false;
         }
 
+        protected override void FinishDestruction()
+        {
+            YARG.Input.ControllerEventLog.StrumBounces(Player?.Profile?.Name, StrumBouncesFiltered);
+            base.FinishDestruction();
+        }
+
+        // ---------------------------------------------------------------- strum bar bounce
+        // (Settings > General > Strum Bar Bounce Filter; see StrumBounceGate)
+
+        private bool _bounceChecked;
+        private YARG.Input.StrumBounceGate _bounceGate;
+
+        /// <summary>How many strums the bounce filter has left out in this song (for the log).</summary>
+        public int StrumBouncesFiltered => _bounceGate?.Filtered ?? 0;
+
+        private bool IsStrumBounce(GuitarAction action, bool pressed, double time)
+        {
+            if (!_bounceChecked)
+            {
+                _bounceChecked = true;
+                var mode = YARG.Settings.SettingsManager.Settings.StrumBounceFilter.Value;
+                if (mode != YARG.Input.StrumBounceFilter.Off && !Player.IsReplay && !Player.Profile.IsBot &&
+                    YARG.Input.ControllerLayout.PlaysOnGuitarController(Player))
+                {
+                    _bounceGate = mode == YARG.Input.StrumBounceFilter.Strong
+                        ? new YARG.Input.StrumBounceGate(0.035, 0.020)
+                        : new YARG.Input.StrumBounceGate(0.020, 0.010);
+                }
+            }
+
+            return _bounceGate != null && _bounceGate.IsBounce(action == GuitarAction.StrumUp, pressed, time);
+        }
+
         protected override void OnInputQueued(GameInput input)
         {
             base.OnInputQueued(input);

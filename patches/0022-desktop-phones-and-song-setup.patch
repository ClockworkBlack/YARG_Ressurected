diff --git a/Assets/Script/Input/Bindings/BindingCollection.Defaults.cs b/Assets/Script/Input/Bindings/BindingCollection.Defaults.cs
index 1e8e34c..34471ab 100644
--- a/Assets/Script/Input/Bindings/BindingCollection.Defaults.cs
+++ b/Assets/Script/Input/Bindings/BindingCollection.Defaults.cs
@@ -13,6 +13,11 @@ namespace YARG.Input
             return device switch
             {
                 Keyboard keyboard => SetDefaultBindings(keyboard),
+                // A phone joined over Wi-Fi always sends the guitar layout (frets on A/B/Y/X/LB,
+                // strum on the D-pad), whichever layout is chosen for real gamepads. Without this,
+                // a phone added to a profile by hand on a computer got the gamepad's buttons.
+                Gamepad gamepad when YARG.Remote.RemotePlayManager.IsRemoteDevice(gamepad)
+                    => SetDefaultBindings(gamepad, GamepadBindingMode.RB4InstrumentMapper_Guitar),
                 Gamepad gamepad => SetDefaultBindings(gamepad, ControllerLayout.GuitarBindingMode),
 
                 FiveFretGuitar guitar => SetDefaultBindings(guitar),

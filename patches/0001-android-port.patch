@@ -0,0 +1,67 @@
+using System;
+using System.Collections.Generic;
+using YARG.Core;
+using YARG.Menu.ProfileList;
+using YARG.Helpers;
+
+namespace YARG.Input.Bindings
+{
+    // YARG Resurrected: "Guitar Hero 2 style" layout for a regular gamepad, matching GH2's
+    // DualShock 2 defaults (StrategyWiki/GameFAQs): frets on L2/L1/R1/R2 + Cross.
+    // GH2 had no strum on a pad (pressing a fret played the note); YARG needs a strum input,
+    // so strum is on the D-pad (Down/Right) or Square/Circle, which GH2 left unused.
+    //
+    //   Green  = L2 / LT        Red    = L1 / LB
+    //   Yellow = R1 / RB        Blue   = R2 / RT
+    //   Orange = Cross / A (south face button)
+    //   Strum  = D-pad Down/Right, or Square / Circle
+    //   Star Power = Select / Back or D-pad Up (as in GH2)
+    //   Whammy = Left stick X (as in GH2)
+    //
+    // Every binding can be changed in YARG's profile binding menu.
+    public static partial class ReusableBindingSetDefaults
+    {
+        private static ReusableButtonBinding GH2Button(string action, params string[] controls)
+        {
+            var configs = new List<ReusableSingleButtonBindingConfig>();
+            foreach (var control in controls)
+            {
+                configs.Add(new ReusableSingleButtonBindingConfig(ControllerFamily.Gamepad, control));
+            }
+
+            return new ReusableButtonBinding(ReusableBindingSetTemplates.FIVE_FRET_GUITAR[action], configs);
+        }
+
+        private static readonly Dictionary<string, ReusableControlBinding> _gamepadGH2StyleGameplay = new()
+        {
+            { ActionStrings.FIVE_FRET_GREEN,  GH2Button(ActionStrings.FIVE_FRET_GREEN,  ControlStrings.GAMEPAD_LEFT_TRIGGER) },
+            { ActionStrings.FIVE_FRET_RED,    GH2Button(ActionStrings.FIVE_FRET_RED,    ControlStrings.GAMEPAD_LEFT_SHOULDER) },
+            { ActionStrings.FIVE_FRET_YELLOW, GH2Button(ActionStrings.FIVE_FRET_YELLOW, ControlStrings.GAMEPAD_RIGHT_SHOULDER) },
+            { ActionStrings.FIVE_FRET_BLUE,   GH2Button(ActionStrings.FIVE_FRET_BLUE,   ControlStrings.GAMEPAD_RIGHT_TRIGGER) },
+            { ActionStrings.FIVE_FRET_ORANGE, GH2Button(ActionStrings.FIVE_FRET_ORANGE, ControlStrings.GAMEPAD_BUTTON_SOUTH) },
+
+            { ActionStrings.GUITAR_STRUM_DOWN, GH2Button(ActionStrings.GUITAR_STRUM_DOWN, ControlStrings.GAMEPAD_DPAD_DOWN, ControlStrings.GAMEPAD_BUTTON_WEST) },
+            { ActionStrings.GUITAR_STRUM_UP,   GH2Button(ActionStrings.GUITAR_STRUM_UP,   ControlStrings.GAMEPAD_DPAD_RIGHT, ControlStrings.GAMEPAD_BUTTON_EAST) },
+
+            { ActionStrings.GUITAR_STAR_POWER, GH2Button(ActionStrings.GUITAR_STAR_POWER, ControlStrings.GAMEPAD_SELECT, ControlStrings.GAMEPAD_DPAD_UP) },
+
+            {
+                ActionStrings.GUITAR_WHAMMY,
+                new ReusableAxisBinding(
+                    ReusableBindingSetTemplates.FIVE_FRET_GUITAR[ActionStrings.GUITAR_WHAMMY],
+                    new ReusableSingleAxisBindingConfig(ControllerFamily.Gamepad, ControlStrings.GAMEPAD_LEFT_STICK_X)
+                )
+            },
+        };
+
+        public static readonly Guid GUID_GAMEPAD_GH2_STYLE = new("6c1e0a52-8f3d-4b7e-9a51-2d7f4c9e1b30");
+        public static readonly ReusableBindingSet DefaultGamepadGH2StyleGameplay = MakeHardcodedBindingSet(
+            "Gamepad - Guitar Hero 2 Style (Shoulder Frets)",
+            GameMode.FiveFretGuitar,
+            ControllerFamily.Gamepad,
+            GUID_GAMEPAD_GH2_STYLE,
+            _gamepadGH2StyleGameplay,
+            "GH2 controller layout: frets L2/L1/R1/R2/Cross, strum D-pad Down/Right or Square/Circle, Star Power Select/D-pad Up, whammy left stick."
+        );
+    }
+}

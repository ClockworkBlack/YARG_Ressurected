diff --git a/Assets/Script/Input/Bindings/Reusable/Defaults/ReusableBindingSetDefaults.Gamepad.GH2Style.cs b/Assets/Script/Input/Bindings/Reusable/Defaults/ReusableBindingSetDefaults.Gamepad.GH2Style.cs

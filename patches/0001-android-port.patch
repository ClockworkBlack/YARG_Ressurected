+#if UNITY_ANDROID && !UNITY_EDITOR
+        private static readonly Dictionary<Gamepad, GamepadBindingMode> _androidGamepads = new();
+
+        private static async UniTask<GamepadBindingMode?> PromptAndroidGamepadMode(Gamepad gamepad)
+        {
+            await DialogManager.Instance.WaitUntilCurrentClosed();
+
+            if (_androidGamepads.TryGetValue(gamepad, out var existing))
+            {
+                return existing;
+            }
+
+            GamepadBindingMode? mode = null;
+
+            var dialog = DialogManager.Instance.ShowList("Which kind of controller is this?");
+            dialog.AddListButton("Gamepad (face buttons = frets)", () => mode = GamepadBindingMode.Gamepad);
+            dialog.AddListButton("Gamepad - Guitar Hero 2 style (shoulder frets)", () => mode = GamepadBindingMode.GamepadGH2Style);
+            dialog.AddListButton("CRKD Guitar (Mode 1)", () => mode = GamepadBindingMode.CrkdGuitar_Mode1);
+            dialog.AddListButton("CRKD Guitar (Mode 1, FW3.0+)", () => mode = GamepadBindingMode.CrkdGuitar_Mode1_Fw30);
+            dialog.AddListButton("Other guitar (PS3/360 dongle)", () => mode = GamepadBindingMode.RB4InstrumentMapper_Guitar);
+            await dialog.WaitUntilClosed();
+
+            if (mode.HasValue)
+            {
+                _androidGamepads[gamepad] = mode.Value;
+            }
+
+            return mode;
+        }
+#endif

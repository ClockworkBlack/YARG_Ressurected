new file mode 100644
index 0000000..5bc0f2a
--- /dev/null
+++ b/Assets/Script/Android/AndroidPlatform.cs
@@ -0,0 +1,137 @@
+// YARG Resurrected - Android platform helpers.
+// Everything here compiles to nothing on non-Android targets.
+#if UNITY_ANDROID && !UNITY_EDITOR
+using System;
+using System.IO;
+using System.IO.Compression;
+using UnityEngine;
+
+namespace YARG.Android
+{
+    public static class AndroidPlatform
+    {
+        /// <summary>
+        /// Public folder players drop songs into (visible in any file manager).
+        /// </summary>
+        public const string PUBLIC_ROOT = "/storage/emulated/0/YARG";
+        public static string DefaultSongsFolder => Path.Combine(PUBLIC_ROOT, "Songs");
+
+        /// <summary>
+        /// On Android, StreamingAssets live inside the APK (a zip) and can't be read with System.IO.
+        /// YARG reads them as normal files everywhere, so copy them out once per build.
+        /// Returns the extracted folder, or the original path if extraction failed.
+        /// </summary>
+        public static string ExtractStreamingAssets(string persistentDataPath, string originalPath)
+        {
+            string target = Path.Combine(persistentDataPath, "StreamingAssets");
+            string stamp = Path.Combine(target, ".extracted");
+            string apkPath = Application.dataPath; // On Android this is the path to base.apk
+            string version = Application.version + "|" + File.GetLastWriteTimeUtc(apkPath).Ticks;
+
+            try
+            {
+                if (File.Exists(stamp) && File.ReadAllText(stamp) == version)
+                {
+                    return target;
+                }
+
+                if (Directory.Exists(target))
+                {
+                    Directory.Delete(target, true);
+                }
+                Directory.CreateDirectory(target);
+
+                using var zip = ZipFile.OpenRead(apkPath);
+                foreach (var entry in zip.Entries)
+                {
+                    // Unity stores StreamingAssets at the APK's assets/ root; assets/bin/ is engine data.
+                    if (!entry.FullName.StartsWith("assets/", StringComparison.Ordinal) ||
+                        entry.FullName.StartsWith("assets/bin/", StringComparison.Ordinal) ||
+                        entry.FullName.EndsWith("/", StringComparison.Ordinal))
+                    {
+                        continue;
+                    }
+
+                    string relative = entry.FullName.Substring("assets/".Length);
+                    string dest = Path.GetFullPath(Path.Combine(target, relative));
+                    if (!dest.StartsWith(Path.GetFullPath(target), StringComparison.Ordinal))
+                    {
+                        continue; // zip-slip guard
+                    }
+
+                    Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+                    entry.ExtractToFile(dest, true);
+                }
+
+                File.WriteAllText(stamp, version);
+                return target;
+            }
+            catch (Exception e)
+            {
+                Debug.LogException(e);
+                return originalPath;
+            }
+        }
+
+        /// <summary>
+        /// Ask for "All files access" so YARG can scan song folders anywhere on shared storage.
+        /// </summary>
+        public static void RequestStorageAccess()
+        {
+            try
+            {
+                using var version = new AndroidJavaClass("android.os.Build$VERSION");
+                int sdk = version.GetStatic<int>("SDK_INT");
+                if (sdk >= 30)
+                {
+                    using var env = new AndroidJavaClass("android.os.Environment");
+                    if (env.CallStatic<bool>("isExternalStorageManager"))
+                    {
+                        return;
+                    }
+
+                    using var player = new AndroidJavaClass("com.unity3d.player.UnityPlayer");
+                    using var activity = player.GetStatic<AndroidJavaObject>("currentActivity");
+                    string package = activity.Call<string>("getPackageName");
+                    using var uriClass = new AndroidJavaClass("android.net.Uri");
+                    using var uri = uriClass.CallStatic<AndroidJavaObject>("parse", "package:" + package);
+                    using var intent = new AndroidJavaObject("android.content.Intent",
+                        "android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION", uri);
+                    activity.Call("startActivity", intent);
+                }
+                else
+                {
+                    UnityEngine.Android.Permission.RequestUserPermission(
+                        UnityEngine.Android.Permission.ExternalStorageRead);
+                    UnityEngine.Android.Permission.RequestUserPermission(
+                        UnityEngine.Android.Permission.ExternalStorageWrite);
+                }
+            }
+            catch (Exception e)
+            {
+                Debug.LogException(e);
+            }
+        }
+
+        /// <summary>
+        /// Make sure the public song folder exists and is in the song folder list.
+        /// </summary>
+        public static void EnsureDefaultSongFolder(System.Collections.Generic.List<string> songFolders)
+        {
+            try
+            {
+                Directory.CreateDirectory(DefaultSongsFolder);
+            }
+            catch (Exception e)
+            {
+                Debug.LogWarning("[YARG Android] Could not create " + DefaultSongsFolder + ": " + e.Message);
+            }
+
+            if (!songFolders.Contains(DefaultSongsFolder))
+            {
+                songFolders.Add(DefaultSongsFolder);
+            }
+        }
+    }
+}
+#endif

+        protected override NavigationScheme GetNavigationScheme()
+        {
+            return new NavigationScheme(new()
+            {
+                new NavigationScheme.Entry(MenuAction.Green, "Menu.Common.Confirm", ConfirmCursor),
+                new NavigationScheme.Entry(MenuAction.Red, "Menu.Common.Back",
+                    () => DialogManager.Instance.ClearDialog()),
+                new NavigationScheme.Entry(MenuAction.Up, "Menu.Common.Up", ctx => MoveCursor(-1, ctx.IsRepeat)),
+                new NavigationScheme.Entry(MenuAction.Down, "Menu.Common.Down", ctx => MoveCursor(1, ctx.IsRepeat)),
+            }, null);
+        }
+
+        private void ConfirmCursor()
+        {
+            if (_cursor >= 0 && _cursor < _listButtons.Count && _listButtons[_cursor] != null)
+            {
+                var unityButton = _listButtons[_cursor].GetComponentInChildren<Button>();
+                if (unityButton == null || unityButton.interactable)
+                {
+                    _listButtons[_cursor].OnClick.Invoke();
+                }
+                return;
+            }
+
+            NavGroup.ConfirmSelection();
+        }
+
+        private void MoveCursor(int direction, bool isRepeat)
+        {
+            _listButtons.RemoveAll(b => b == null);
+            if (_cursor >= _listButtons.Count)
+            {
+                _cursor = -1;
+            }
+
+            var group = NavGroup;
+
+            if (_cursor >= 0)
+            {
+                // In the list
+                int next = _cursor + direction;
+                if (next >= 0 && next < _listButtons.Count)
+                {
+                    MoveCursorTo(next, true);
+                }
+                else if (group.Count > 0 && !isRepeat)
+                {
+                    // Off either end: on to the buttons under the list (Close)
+                    MoveCursorTo(-1, false);
+                    if (direction > 0)
+                    {
+                        group.SelectFirst();
+                    }
+                    else
+                    {
+                        group.SelectLast();
+                    }
+                }
+                return;
+            }
+
+            // On the buttons under the list
+            int? selected = group.SelectedIndex;
+            bool leavingGroup = selected is null ||
+                (direction > 0 ? selected >= group.Count - 1 : selected <= 0);
+            if (leavingGroup && _listButtons.Count > 0)
+            {
+                if (isRepeat && selected is not null)
+                {
+                    return;
+                }
+
+                group.ClearSelection();
+                MoveCursorTo(direction > 0 ? 0 : _listButtons.Count - 1, true);
+            }
+            else if (direction > 0)
+            {
+                group.SelectNext(isRepeat);
+            }
+            else
+            {
+                group.SelectPrevious(isRepeat);
+            }
+        }
+
+        private void MoveCursorTo(int index, bool scroll)
+        {
+            // Un-highlight the old one
+            if (_cursor >= 0 && _cursor < _listButtons.Count && _listButtons[_cursor] != null)
+            {
+                var old = _listButtons[_cursor];
+                var unityButton = old.GetComponentInChildren<Button>();
+                if (unityButton == null || unityButton.interactable)
+                {
+                    old.EnableButton();
+                }
+            }
+
+            _cursor = index;
+            if (index < 0 || index >= _listButtons.Count || _listButtons[index] == null)
+            {
+                return;
+            }
+
+            var button = _listButtons[index];
+            button.SetBackgroundAndTextColor(MenuData.Colors.BrightButton);
+
+            if (scroll)
+            {
+                ScrollTo(button.transform as RectTransform);
+            }
+        }
+
+        // Scrolls the list so the highlighted button is in the middle (or as near as the ends allow)
+        private void ScrollTo(RectTransform item)
+        {
+            var scrollRect = _listContainer.GetComponentInParent<ScrollRect>();
+            if (item == null || scrollRect == null || scrollRect.content == null)
+            {
+                return;
+            }
+
+            Canvas.ForceUpdateCanvases();
+
+            var content = scrollRect.content;
+            var viewport = scrollRect.viewport != null ? scrollRect.viewport : (RectTransform) scrollRect.transform;
+
+            float scrollable = content.rect.height - viewport.rect.height;
+            if (scrollable <= 0f)
+            {
+                return;
+            }
+
+            // How far the item's middle is below the top of the content
+            var itemCenter = content.InverseTransformPoint(item.TransformPoint(item.rect.center));
+            float fromTop = content.rect.yMax - itemCenter.y;
+
+            float target = Mathf.Clamp(fromTop - viewport.rect.height / 2f, 0f, scrollable);
+            scrollRect.StopMovement();
+            scrollRect.verticalNormalizedPosition = 1f - target / scrollable;
+        }
     }
 }

         private readonly List<StemData> _stemDatas = new();
         private          int            _longestHandle;
 
+        /// <summary>
+        /// Set on the loading thread while a song's audio is being loaded to make the mixer keep
+        /// a private copy of each source file. The guitar voice reads these copies to listen to
+        /// the song before it is played (see <c>GuitarVoiceLoader</c>).
+        /// </summary>
+        [ThreadStatic]
+        public static bool KeepSourceCopies;
+
+        private List<(MemoryStream Data, StemInfo[] Stems)> _sourceCopies;
+
+        /// <summary>The copies kept while <see cref="KeepSourceCopies"/> was set (may be null).</summary>
+        public IReadOnlyList<(MemoryStream Data, StemInfo[] Stems)> SourceCopies => _sourceCopies;
+
+        public void DropSourceCopies()
+        {
+            if (_sourceCopies == null)
+            {
+                return;
+            }
+            foreach (var (data, _) in _sourceCopies)
+            {
+                data.Dispose();
+            }
+            _sourceCopies = null;
+        }
+
+        private void KeepSourceCopy(Stream stream, StemInfo[] stemInfos)
+        {
+            try
+            {
+                if (!stream.CanRead || !stream.CanSeek)
+                {
+                    return;
+                }
+                long position = stream.Position;
+                try
+                {
+                    stream.Position = 0;
+                    var copy = new MemoryStream();
+                    stream.CopyTo(copy);
+                    copy.Position = 0;
+                    _sourceCopies ??= new();
+                    _sourceCopies.Add((copy, stemInfos));
+                }
+                finally
+                {
+                    stream.Position = position;
+                }
+            }
+            catch (Exception e)
+            {
+                YargLogger.LogException(e, "Could not keep a copy of a song source");
+            }
+        }
+

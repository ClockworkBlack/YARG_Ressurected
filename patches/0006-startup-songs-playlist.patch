diff --git a/Assets/Script/Playlists/PlaylistContainer.cs b/Assets/Script/Playlists/PlaylistContainer.cs
index 0fc801f..ae8860e 100644
--- a/Assets/Script/Playlists/PlaylistContainer.cs
+++ b/Assets/Script/Playlists/PlaylistContainer.cs
@@ -172,6 +172,35 @@ namespace YARG.Playlists
             return playlist;
         }
 
+        /// <summary>
+        /// The playlist with this id, made (empty, named <paramref name="name"/>) if it doesn't exist yet.
+        /// Used for playlists the game itself relies on, like the menu's Startup Songs.
+        /// </summary>
+        public static Playlist GetOrCreatePlaylist(Guid id, string name)
+        {
+            foreach (var existing in _playlists)
+            {
+                if (existing.Id == id)
+                {
+                    return existing;
+                }
+            }
+
+            var playlist = new Playlist
+            {
+                Name = name,
+                Author = "You",
+                Id = id,
+                SongHashes = new List<HashWrapper>()
+            };
+
+            SavePlaylist(playlist);
+            _playlists.Add(playlist);
+            SortPlaylistsByName();
+            RefreshMenuMusicChoices();
+            return playlist;
+        }
+
         public static void DeletePlaylist(Playlist playlist)
         {
             _playlists.Remove(playlist);

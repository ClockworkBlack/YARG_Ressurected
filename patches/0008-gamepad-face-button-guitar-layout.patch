+        // Frets on the face buttons, on the same buttons as the menu colors (and the button icons):
+        // Cross green, Circle red, Triangle yellow, Square blue on a PlayStation pad, L1 orange.
+        // The left thumb strums on the D-pad, the right index finger has Star Power (R1) and the
+        // whammy bar (R2, the further it's pressed the more it bends).
+        private bool SetDefaultFiveFretBindings_GamepadFace(Gamepad gamepad)
+        {
+            if (Mode != GameMode.FiveFretGuitar)
+                return false;
+
+            foreach (var button in new[] { PadButton.South, PadButton.East, PadButton.North, PadButton.West })
+            {
+                var fret = ControllerLayout.ToMenuAction(button) switch
+                {
+                    MenuAction.Green  => GuitarAction.GreenFret,
+                    MenuAction.Red    => GuitarAction.RedFret,
+                    MenuAction.Yellow => GuitarAction.YellowFret,
+                    _                 => GuitarAction.BlueFret,
+                };
+                AddBinding(fret, ControllerLayout.GetControl(gamepad, button));
+            }
+            AddBinding(GuitarAction.OrangeFret, gamepad.leftShoulder);
+
+            AddBinding(GuitarAction.StrumUp, gamepad.dpad.up);
+            AddBinding(GuitarAction.StrumDown, gamepad.dpad.down);
+
+            AddBinding(GuitarAction.StarPower, gamepad.rightShoulder);
+            AddBinding(GuitarAction.StarPower, gamepad.selectButton);
+
+            AddBinding(GuitarAction.Whammy, gamepad.rightTrigger);
+
+            return true;
+        }

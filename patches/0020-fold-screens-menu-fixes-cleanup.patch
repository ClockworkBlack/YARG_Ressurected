diff --git a/Assets/Script/Helpers/ScreenHelper.cs b/Assets/Script/Helpers/ScreenHelper.cs
index 98cb3f7..51e2bec 100644
--- a/Assets/Script/Helpers/ScreenHelper.cs
+++ b/Assets/Script/Helpers/ScreenHelper.cs
@@ -72,6 +72,15 @@ namespace YARG.Helpers
         /// </summary>
         public static void SetResolution(Resolution resolution)
         {
+            // YARG Resurrected: on a phone the game always fills its window, and Android changes
+            // that window (folding or unfolding a Fold, turning the phone, split screen). Forcing
+            // a size here, the one saved from the other screen or the display's own size in the
+            // other orientation, left the picture stretched or squashed.
+            if (Application.isMobilePlatform)
+            {
+                return;
+            }
+
             YargLogger.LogFormatDebug("Changing screen resolution to {0}", resolution);
             var fullscreenMode = SettingsManager.Settings?.FullscreenMode.Value ?? FullScreenMode.FullScreenWindow;
             Screen.SetResolution(resolution.width, resolution.height, fullscreenMode, resolution.refreshRateRatio);
diff --git a/Assets/Script/Input/Touch/TouchControlsBootstrap.cs b/Assets/Script/Input/Touch/TouchControlsBootstrap.cs
index f488d39..fbffcc2 100644
--- a/Assets/Script/Input/Touch/TouchControlsBootstrap.cs
+++ b/Assets/Script/Input/Touch/TouchControlsBootstrap.cs
@@ -41,13 +41,11 @@ namespace YARG.Input.Touch
 
         private static void ApplyAndroidOrientation()
         {
-            // Landscape lock + never sleep on Android (belt and braces next to
-            // the PlayerSettings default orientation, which is already
-            // LandscapeRight). Build #15 used LandscapeLeft here and the
-            // phone showed the game upside-down (180° reversed).
+            // Never sleep on Android. (The orientation is left to OrientationUnlock: this used to
+            // pin landscape on every scene load, which fought it, and on a Fold turned the game
+            // sideways or upside-down depending on which of the two ran last.)
             if (Application.platform == RuntimePlatform.Android)
             {
-                Screen.orientation = ScreenOrientation.LandscapeRight;
                 Screen.sleepTimeout = SleepTimeout.NeverSleep;
             }
         }

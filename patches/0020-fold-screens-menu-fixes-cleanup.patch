+        private GameObject _focusFrame;
+
+        private void ShowFocusFrame(bool selected)
+        {
+            if (!selected && _focusFrame == null)
+            {
+                return;
+            }
+
+            if (_focusFrame == null)
+            {
+                if (transform is not RectTransform)
+                {
+                    return;
+                }
+
+                _focusFrame = new GameObject("Focus Frame", typeof(RectTransform));
+                var frame = (RectTransform) _focusFrame.transform;
+                frame.SetParent(transform, false);
+                frame.anchorMin = Vector2.zero;
+                frame.anchorMax = Vector2.one;
+                frame.offsetMin = Vector2.zero;
+                frame.offsetMax = Vector2.zero;
+                // Not part of the item's own layout
+                _focusFrame.AddComponent<LayoutElement>().ignoreLayout = true;
+
+                Edge(frame, new Vector2(0f, 1f), new Vector2(1f, 1f), new Vector2(0f, -FRAME), Vector2.zero);
+                Edge(frame, new Vector2(0f, 0f), new Vector2(1f, 0f), Vector2.zero, new Vector2(0f, FRAME));
+                Edge(frame, new Vector2(1f, 0f), new Vector2(1f, 1f), new Vector2(-FRAME, 0f), Vector2.zero);
+                Edge(frame, new Vector2(0f, 0f), new Vector2(0f, 1f), Vector2.zero, new Vector2(BAR, 0f));
+            }
+
+            if (selected)
+            {
+                // Drawn over the item's own pieces
+                _focusFrame.transform.SetAsLastSibling();
+            }
+            _focusFrame.SetActive(selected);
+        }
+
+        private static void Edge(RectTransform parent, Vector2 anchorMin, Vector2 anchorMax, Vector2 offsetMin, Vector2 offsetMax)
+        {
+            var edge = new GameObject("Edge", typeof(RectTransform));
+            var rect = (RectTransform) edge.transform;
+            rect.SetParent(parent, false);
+            rect.anchorMin = anchorMin;
+            rect.anchorMax = anchorMax;
+            rect.offsetMin = offsetMin;
+            rect.offsetMax = offsetMax;
+            var image = edge.AddComponent<Image>();
+            image.color = FocusColor;
+            image.raycastTarget = false;
+        }

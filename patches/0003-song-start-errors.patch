+        /// <summary>
+        /// Says on screen why the song could not start, and goes back to the menu.
+        /// </summary>
+        private void ReportStartFailure(Exception ex)
+        {
+            YargLogger.LogException(ex, "Failed to start the song!");
+
+            try
+            {
+                // The first few lines of the stack trace say where it happened
+                string trace = ex.StackTrace ?? string.Empty;
+                int cut = 0;
+                for (int line = 0; line < 4 && cut >= 0 && cut < trace.Length; line++)
+                {
+                    cut = trace.IndexOf('\n', cut + 1);
+                }
+                if (cut > 0)
+                {
+                    trace = trace.Substring(0, cut);
+                }
+
+                DialogManager.Instance.ShowMessage("Could Not Start This Song",
+                    $"{ex.GetType().Name}: {ex.Message}\n\n<size=60%>{trace}</size>");
+            }
+            catch (Exception dialogException)
+            {
+                YargLogger.LogException(dialogException);
+                ToastManager.ToastError("Could not start this song!");
+            }
+
+            GlobalVariables.Instance.LoadScene(SceneIndex.Menu);
+        }

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Compile only, never run: the story's plain .NET files against the API set Unity guarantees
         (.NET Standard 2.1) with Unity 6's language version. A call that only exists in newer .NET
         (Random.Shared, MaxBy, System.Text.Json, records...) fails here instead of in the APK build. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>StoryApiCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../overlay/Assets/Script/Story/Core/*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>

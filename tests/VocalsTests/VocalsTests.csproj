<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for singing: the pitch detector, the microphone timing, and the vocals scoring engine
    (including Vocals Challenge Mode), run against a synthetic singer.

    They compile the game's own files, so they need the game's source with this repo's patches
    applied (the Android workflow does that; see .github/workflows/android.yml):
      dotnet run -c Release -p:YargProjectDir=/path/to/patched/YARG-DROID
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 6 compiles C# 9, so test with the same language version. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>VocalsTests</RootNamespace>
    <YargProjectDir Condition="'$(YargProjectDir)' == ''">../../project</YargProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- New code from this repo -->
    <Compile Include="../../overlay/Assets/Script/Audio/Vocals/VoiceAnalyzer.cs" Link="Game/VoiceAnalyzer.cs" />
    <Compile Include="../../overlay/Assets/Script/Audio/Vocals/VoiceInput.cs" Link="Game/VoiceInput.cs" />
    <Compile Include="../../overlay/Assets/Script/Audio/Vocals/VoiceMic.cs" Link="Game/VoiceMic.cs" />

    <!-- YARG's original pitch tracker, to compare against -->
    <Compile Include="$(YargProjectDir)/Assets/Script/Audio/PitchDetection/PitchTracker.cs" Link="Game/PitchTracker.cs" />
    <Compile Include="$(YargProjectDir)/Assets/Script/Audio/PitchDetection/PitchProcessor.cs" Link="Game/PitchProcessor.cs" />
    <Compile Include="$(YargProjectDir)/Assets/Script/Audio/PitchDetection/IIRFilter.cs" Link="Game/IIRFilter.cs" />
    <Compile Include="$(YargProjectDir)/Assets/Script/Audio/PitchDetection/CircularBuffer.cs" Link="Game/CircularBuffer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scoring engine (YARG.Core with patches-core applied) -->
    <ProjectReference Include="$(YargProjectDir)/YARG.Core/YARG.Core/YARG.Core.csproj" />
  </ItemGroup>

</Project>
